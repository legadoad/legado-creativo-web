# Instagram Graph API (Instagram Login) — used by app/api/instagram/route.ts
# and lib/instagram.ts to power the Instagram feed section (components/instagram-feed.tsx).
#
# 1. In Meta Developers > your app > Instagram > API setup with Instagram login,
#    generate a user access token for the connected Instagram business/creator account.
# 2. Exchange it for a long-lived token (valid ~60 days):
#    GET https://graph.instagram.com/access_token
#      ?grant_type=ig_exchange_token
#      &client_secret=<APP_SECRET>
#      &access_token=<SHORT_LIVED_TOKEN>
# 3. Paste the long-lived token below. Without it, the feed section falls back to
#    sample posts in development and hides itself entirely in production.
INSTAGRAM_ACCESS_TOKEN=IGAAec0T88okNBZAFpWc3hOTE91ZA2txNlpkc1VZAX0szUHNwWk5SV1R0ODEyRWNLUTdHbXI3WDQtY3d6aGQ0ZAXFxdldQRzRlWHlab3lDbWNSNWc1NlBLM0dfbFkzSmhVNWpNVnlVVHl3NGJzek1teUVlYnprX1dUUHc5SXJfalRRdwZDZD

# Automatic token renewal (production only) — app/api/cron/instagram-token/route.ts,
# scheduled in vercel.json (1st and 15th of each month). The renewed token is stored
# in a Vercel Edge Config; INSTAGRAM_ACCESS_TOKEN above remains the seed, and pasting
# a new one there takes over automatically.
# 1. Vercel > Storage > Create > Edge Config, then connect it to this project.
#    Vercel adds EDGE_CONFIG (the connection string) for you.
# 2. Create an API token at https://vercel.com/account/tokens -> VERCEL_API_TOKEN.
# 3. If the project belongs to a team, set VERCEL_TEAM_ID (Team Settings > General).
# 4. CRON_SECRET: any long random string (e.g. `openssl rand -hex 32`). Vercel sends
#    it as a Bearer token when it calls the cron route.
EDGE_CONFIG=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
CRON_SECRET=

# Resend — sends the contact form (app/api/contact/route.ts) using the
# template in emails/contact-email.tsx. Get a key at https://resend.com/api-keys.
# The "from" address's domain must be verified in the Resend dashboard first
# (Domains > Add Domain), otherwise sending fails.
RESEND_API_KEY=

# Where contact form submissions are delivered. Defaults to
# vickyurbaneja@gmail.com (see app/api/contact/route.ts) if unset.
CONTACT_TO_EMAIL=vickyurbaneja@gmail.com

# The "from" address contact emails are sent as — must be on a domain
# verified in Resend. Defaults to this value in app/api/contact/route.ts if unset.
CONTACT_FROM_EMAIL="Legado Creativo <contact@legadocreativo.com>"

# Cloudflare Turnstile — bot protection on the contact form.
# 1. Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
#    for the domain legadocreativo.com.
# 2. Paste the Site Key (public, safe client-side) and Secret Key (server-only) below.
# Without these, the widget doesn't render and the API route skips
# verification (see lib/turnstile.ts) — the form still works, just without
# bot protection, so it's safe to deploy before these are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
